# Anthropic API — required for real LLM/agent runs (not needed for the default test suite).
ANTHROPIC_API_KEY=

# Storage
GATE_DB_PATH=checkpoints.db
# Schema generation of the checkpointed state. The app refuses to start against a checkpoints.db
# recorded at a different version; there is no migration — delete the file and re-run.
GATE_STATE_VERSION=2
# Optional: overrides the asset-resolved policy index. Leave unset to use the bundled/repo copy.
# GATE_POLICY_INDEX=data/policies/index.yaml

# Model tiers (env-driven; verify IDs against the live Anthropic API before a real run).
# Each tier pairs a model with its reasoning effort: low | medium | high | xhigh | max.
# Effort applies to Sonnet/Opus/Fable only — a tier whose model is Haiku never receives one.
GATE_MODEL_CLASSIFIER=claude-haiku-4-5
GATE_MODEL_CLASSIFIER_EFFORT=high
GATE_MODEL_SPECIALIST=claude-sonnet-5
GATE_MODEL_SPECIALIST_EFFORT=high
GATE_MODEL_INVESTIGATOR=claude-sonnet-5
GATE_MODEL_INVESTIGATOR_EFFORT=high

# Risk gate + orchestration budgets
GATE_RISK_THRESHOLD=40
GATE_RISK_HIGH_BOUND=75
GATE_MAX_CYCLES=2
GATE_SPECIALIST_TIMEOUT_S=60
GATE_MAX_DIFF_CHARS=20000

# Investigator sub-agent budgets
GATE_INVESTIGATOR_MAX_TURNS=8
GATE_INVESTIGATOR_MAX_TOOL_CALLS=15
GATE_INVESTIGATOR_MAX_FILE_CHARS=15000


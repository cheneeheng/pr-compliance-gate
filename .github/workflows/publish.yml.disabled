name: Publish

# DISABLED. Publication to PyPI is on hold until the pipeline reads live GitHub pull
# requests instead of local fixtures. GitHub only registers workflows ending in .yml or
# .yaml, so the `.disabled` suffix means no trigger here can fire — not the `release:
# published` one, not the manual dispatch. To re-enable: `git mv` it back to publish.yml
# and complete the one-time Trusted Publishing setup described below.
#
# Trusted Publishing (OIDC): the pypi/testpypi environments are registered as
# pending publishers on (test.)pypi.org — no API tokens stored in the repo.
# One-time setup, on each of pypi.org and test.pypi.org: Publishing -> add a GitHub
# publisher (owner `cheneeheng`, repo `pr-compliance-gate`, workflow `publish.yml`,
# environment `pypi` / `testpypi`), then create the matching GitHub environments.
on:
  release:
    types: [published]
  workflow_dispatch: # manual trigger for the TestPyPI dry run

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - run: uv build
      # A release tag that disagrees with project.version would publish the wrong
      # version under the right name, and PyPI never lets that filename be reused.
      - name: Verify the release tag matches the built version
        if: github.event_name == 'release'
        run: |
          test -f "dist/pr_compliance_gate-${GITHUB_REF_NAME#v}.tar.gz" || {
            echo "tag ${GITHUB_REF_NAME} does not match the built distribution:"
            ls dist
            exit 1
          }
      - name: Audit the locked runtime dependencies
        run: |
          uv export --no-dev --no-emit-project --format requirements-txt > requirements.audit.txt
          # Three advisories against mcp 1.23.3, all in the package's *server* half. This project
          # imports `ClientSession` and `stdio_client` only (intake/sources/github_mcp.py) and
          # never runs an MCP server, so none of the vulnerable code paths exist here:
          #   PYSEC-2026-3481  server.experimental.enable_tasks() — cross-session task access
          #   PYSEC-2026-3482  SSE / Streamable HTTP session hijack via a known session id
          #   PYSEC-2026-3483  deprecated WebSocket transport — no Host/Origin validation
          # The version is not a choice either: semgrep==1.172.0, the pinned static-analysis
          # extra and the latest release, pins mcp==1.23.3 exactly. Drop these ignores when
          # semgrep relaxes that pin and the lock can move to mcp>=1.28.1.
          uvx pip-audit -r requirements.audit.txt \
            --ignore-vuln PYSEC-2026-3481 \
            --ignore-vuln PYSEC-2026-3482 \
            --ignore-vuln PYSEC-2026-3483
      - uses: actions/upload-artifact@v4
        with:
          name: dist
          path: dist/

  publish-testpypi:
    if: github.event_name == 'workflow_dispatch'
    needs: build
    runs-on: ubuntu-latest
    environment: testpypi
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: dist
          path: dist/
      - uses: pypa/gh-action-pypi-publish@release/v1
        with:
          repository-url: https://test.pypi.org/legacy/

  publish-pypi:
    if: github.event_name == 'release'
    needs: build
    runs-on: ubuntu-latest
    environment: pypi
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: dist
          path: dist/
      - uses: pypa/gh-action-pypi-publish@release/v1
